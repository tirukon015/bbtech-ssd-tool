<Window x:Class="BBTechSSDTool.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:models="clr-namespace:BBTechSSDTool.Models"
        xmlns:views="clr-namespace:BBTechSSDTool.Views"
        mc:Ignorable="d"
        Title="BBTech SSD Tool" 
        Height="650" 
        Width="940" 
        MinHeight="480" 
        MinWidth="750" 
        WindowStartupLocation="CenterScreen" 
        Background="{StaticResource AppBackgroundBrush}">

    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- Top Header Bar -->
        <Border Grid.Row="0" 
                Background="{StaticResource HeaderBackgroundBrush}" 
                BorderBrush="{StaticResource SubtleBorderBrush}" 
                BorderThickness="0,0,0,1" 
                Padding="16,10">
            <Grid MaxWidth="920" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <!-- Branding & Title -->
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Tech Icon Accent -->
                    <Border Background="{StaticResource PrimaryAccentBrush}" 
                            CornerRadius="4" 
                            Width="26" 
                            Height="26" 
                            Margin="0,0,12,0">
                        <TextBlock Text="⚡" 
                                   Foreground="#0F1318" 
                                   FontWeight="Bold" 
                                   FontSize="15" 
                                   HorizontalAlignment="Center" 
                                   VerticalAlignment="Center" />
                    </Border>

                    <TextBlock Text="BBTech SSD Tool" 
                               FontWeight="Bold" 
                               FontSize="19" 
                               Foreground="{StaticResource LightTextBrush}" 
                               VerticalAlignment="Center" />

                    <Border Background="#212A36" 
                            CornerRadius="3" 
                            Padding="6,2" 
                            Margin="10,0,0,0" 
                            VerticalAlignment="Center">
                        <TextBlock Text="v1.0.0" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="{StaticResource PrimaryAccentBrush}" />
                    </Border>

                    <TextBlock Text="  •  Technician Edition" 
                               FontSize="13" 
                               Foreground="{StaticResource MutedTextBrush}" 
                               VerticalAlignment="Center" />
                </StackPanel>

                <!-- Header Actions / Elevation Status & Gear Preferences -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Gear Preferences Button -->
                    <Button Content="⚙ PREFERENCES" 
                            Command="{Binding ToggleSettingsCommand}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="11,5" 
                            FontSize="11" 
                            Margin="0,0,8,0" />

                    <Border Background="#1A2D23" 
                            BorderBrush="{StaticResource SuccessBrush}" 
                            BorderThickness="1" 
                            CornerRadius="3" 
                            Padding="10,4" 
                            Margin="0,0,12,0"
                            Visibility="{Binding IsElevated, Converter={StaticResource BoolToVisibilityConverter}}">
                        <TextBlock Text="🛡 ELEVATED ADMIN ACCESS" 
                                   FontWeight="Bold" 
                                   FontSize="11" 
                                   Foreground="{StaticResource SuccessBrush}" />
                    </Border>
                    <Button Content="⚡ ELEVATE TO ADMIN" 
                            Command="{Binding ElevateCommand}" 
                            Visibility="{Binding IsElevated, Converter={StaticResource InverseBoolToVisibilityConverter}}" 
                            Style="{StaticResource DangerButtonStyle}" 
                            Padding="12,5" 
                            FontSize="11" 
                            Margin="0,0,4,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Dynamic View Area -->
        <Grid Grid.Row="1">
            <!-- 1. Dashboard View (Primary Screen) -->
            <views:DashboardView Visibility="{Binding IsDashboardView, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- 2. Dedicated Format Page (Rufus-inspired) -->
            <views:FormatView DataContext="{Binding FormatViewModel}" 
                              Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsFormatView, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- 3. Dedicated Detailed Health Diagnostics View -->
            <views:HealthDetailsView DataContext="{Binding HealthDetailsViewModel}" 
                                     Visibility="{Binding RelativeSource={RelativeSource AncestorType=Window}, Path=DataContext.IsHealthDetailsView, Converter={StaticResource BoolToVisibilityConverter}}" />

            <!-- 4. Gear (⚙) Settings & Preferences Modal Overlay -->
            <Grid Visibility="{Binding IsSettingsDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}"
                  Background="#D9090D12"
                  Panel.ZIndex="1000">
                <Border Background="#161E28"
                        BorderBrush="#00A3FF"
                        BorderThickness="1"
                        CornerRadius="8"
                        MaxWidth="520"
                        VerticalAlignment="Center"
                        HorizontalAlignment="Center"
                        Padding="24">
                    <StackPanel Orientation="Vertical">
                        <!-- Modal Header -->
                        <Grid Margin="0,0,0,16">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                <TextBlock Text="⚙" FontSize="18" Foreground="#00A3FF" Margin="0,0,8,0" VerticalAlignment="Center" />
                                <TextBlock Text="DASHBOARD &amp; FORMAT PREFERENCES" 
                                           FontWeight="Bold" 
                                           FontSize="14" 
                                           Foreground="#FFFFFF" 
                                           VerticalAlignment="Center" />
                            </StackPanel>
                            <Button Grid.Column="1" 
                                    Content="✕" 
                                    Command="{Binding ToggleSettingsCommand}" 
                                    Background="Transparent" 
                                    BorderThickness="0" 
                                    Foreground="#90A4AE" 
                                    FontSize="14" 
                                    FontWeight="Bold"
                                    Cursor="Hand" />
                        </Grid>

                        <Rectangle Height="1" Fill="#283444" Margin="0,0,0,16" />

                        <TextBlock Text="CONFIGURE VISIBLE DRIVE ACTIONS" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="#00A3FF" 
                                   Margin="0,0,0,10" />

                        <!-- Toggle Quick Format -->
                        <CheckBox IsChecked="{Binding ShowQuickFormatButton}" 
                                  Margin="0,0,0,12" 
                                  Cursor="Hand">
                            <StackPanel Orientation="Vertical" Margin="6,0,0,0">
                                <TextBlock Text="Enable [ ⚡ QUICK FORMAT ] on Drive Cards" 
                                           FontWeight="Bold" 
                                           FontSize="12" 
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="Allows 1-click format directly from dashboard with instant confirmation." 
                                           FontSize="11" 
                                           Foreground="#90A4AE" />
                            </StackPanel>
                        </CheckBox>

                        <!-- Toggle Rufus Format -->
                        <CheckBox IsChecked="{Binding ShowRufusFormatButton}" 
                                  Margin="0,0,0,16" 
                                  Cursor="Hand">
                            <StackPanel Orientation="Vertical" Margin="6,0,0,0">
                                <TextBlock Text="Enable [ ⚙ RUFUS FORMAT ] on Drive Cards" 
                                           FontWeight="Bold" 
                                           FontSize="12" 
                                           Foreground="#FFFFFF" />
                                <TextBlock Text="Opens advanced Rufus page (bootable ISO, Windows To Go, FreeDOS, cluster size)." 
                                           FontSize="11" 
                                           Foreground="#90A4AE" />
                            </StackPanel>
                        </CheckBox>

                        <Rectangle Height="1" Fill="#283444" Margin="0,0,0,16" />

                        <TextBlock Text="DEFAULT QUICK FORMAT PREFERENCES" 
                                   FontSize="11" 
                                   FontWeight="Bold" 
                                   Foreground="#00A3FF" 
                                   Margin="0,0,0,10" />

                        <Grid Margin="0,0,0,10">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="12" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <StackPanel Grid.Column="0">
                                <TextBlock Text="Default File System" FontSize="11" Foreground="#90A4AE" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding DefaultQuickFileSystem}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="NTFS (Default)" Tag="{x:Static models:FileSystemType.NTFS}" />
                                    <ComboBoxItem Content="exFAT" Tag="{x:Static models:FileSystemType.exFAT}" />
                                    <ComboBoxItem Content="FAT32" Tag="{x:Static models:FileSystemType.FAT32}" />
                                </ComboBox>
                            </StackPanel>
                            <StackPanel Grid.Column="2">
                                <TextBlock Text="Partition Scheme" FontSize="11" Foreground="#90A4AE" Margin="0,0,0,4" />
                                <ComboBox SelectedValue="{Binding DefaultQuickPartitionScheme}"
                                          SelectedValuePath="Tag">
                                    <ComboBoxItem Content="GPT (Modern UEFI)" Tag="{x:Static models:PartitionScheme.GPT}" />
                                    <ComboBoxItem Content="MBR (Legacy BIOS)" Tag="{x:Static models:PartitionScheme.MBR}" />
                                </ComboBox>
                            </StackPanel>
                        </Grid>

                        <TextBlock Text="Default Volume Label" FontSize="11" Foreground="#90A4AE" Margin="0,0,0,4" />
                        <TextBox Text="{Binding DefaultQuickVolumeLabel, UpdateSourceTrigger=PropertyChanged}" 
                                 Margin="0,0,0,20" 
                                 Height="34" 
                                 Padding="8,6" 
                                 FontSize="12" />

                        <!-- Close / Save Button -->
                        <Button Content="SAVE &amp; CLOSE" 
                                Command="{Binding ToggleSettingsCommand}" 
                                Style="{StaticResource PrimaryButtonStyle}" 
                                Height="36" 
                                FontWeight="Bold" 
                                FontSize="12" />
                    </StackPanel>
                </Border>
            </Grid>
        </Grid>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="2" 
                Background="{StaticResource HeaderBackgroundBrush}" 
                BorderBrush="{StaticResource SubtleBorderBrush}" 
                BorderThickness="0,1,0,0" 
                Padding="16,6">
            <Grid MaxWidth="920" HorizontalAlignment="Stretch">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Pulsing status dot -->
                    <Ellipse Width="8" Height="8" Fill="{StaticResource SuccessBrush}" Margin="0,0,8,0" />
                    <TextBlock Text="{Binding StatusText}" 
                               FontSize="12" 
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>

                <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Automatic USB Enclosure Arrival / Removal Detection Active" 
                               FontSize="11" 
                               Foreground="#526071" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
