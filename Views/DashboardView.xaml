<UserControl x:Class="BBTechSSDTool.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:BBTechSSDTool.Models"
             xmlns:viewmodels="clr-namespace:BBTechSSDTool.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:MainViewModel}"
             Background="Transparent">

    <Grid>
        <!-- Responsive, Centered Container optimized for 13", 14", 15" laptops & wide monitors -->
        <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <Grid MaxWidth="920" Margin="16,12" HorizontalAlignment="Center">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <!-- Section Title & Refresh Bar -->
                <Grid Grid.Row="0" Margin="0,0,0,12">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Vertical">
                        <TextBlock Text="CONNECTED STORAGE DRIVES" 
                                   FontWeight="Bold" 
                                   FontSize="13" 
                                   Foreground="{StaticResource MutedTextBrush}" />
                        <TextBlock Text="Automatic hardware discovery &amp; live health diagnostics" 
                                   FontSize="11" 
                                   Foreground="#5A6C80" 
                                   Margin="0,2,0,0" />
                    </StackPanel>

                    <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="↻ REFRESH DRIVES" 
                                Command="{Binding RefreshDrivesCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="12,6" 
                                FontSize="11" />
                    </StackPanel>
                </Grid>

                <!-- Drives Cards List -->
                <ItemsControl Grid.Row="1" ItemsSource="{Binding Drives}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type models:PhysicalDriveInfo}">
                            <Border Background="{StaticResource CardBackgroundBrush}" 
                                    BorderBrush="{StaticResource CardBorderBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="6" 
                                    Margin="0,0,0,14" 
                                    Padding="16,14">
                                <Grid>
                                    <Grid.RowDefinitions>
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                        <RowDefinition Height="Auto" />
                                    </Grid.RowDefinitions>

                                    <!-- Top Row: Drive Name, Capacity, Connection, Badges -->
                                    <Grid Grid.Row="0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Model & Technical Metadata -->
                                        <StackPanel Orientation="Vertical">
                                            <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                                <!-- Status dot -->
                                                <Ellipse Width="11" Height="11" 
                                                         Fill="{Binding HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}" 
                                                         Margin="0,0,8,0" />
                                                <TextBlock Text="{Binding Model}" 
                                                           FontWeight="Bold" 
                                                           FontSize="16" 
                                                           Foreground="{StaticResource LightTextBrush}" />
                                                <TextBlock Text="  " />
                                                <TextBlock Text="{Binding FormattedCapacity}" 
                                                           FontWeight="Bold" 
                                                           FontSize="16" 
                                                           Foreground="{StaticResource PrimaryAccentBrush}" />
                                            </StackPanel>

                                            <!-- Secondary Info Badges -->
                                            <WrapPanel Orientation="Horizontal" Margin="19,4,0,0">
                                                <Border Background="#161B22" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding DiskNumber, StringFormat='Disk {0}'}" 
                                                               FontWeight="Bold" 
                                                               FontSize="11" 
                                                               Foreground="#90A4AE" />
                                                </Border>
                                                <Border Background="#161B22" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <TextBlock Text="{Binding InterfaceDisplay}" 
                                                               FontWeight="SemiBold" 
                                                               FontSize="11" 
                                                               Foreground="{StaticResource PrimaryAccentBrush}" />
                                                </Border>
                                                <Border Background="#161B22" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Serial: " FontSize="11" Foreground="#607286" />
                                                        <TextBlock Text="{Binding SerialNumber}" FontSize="11" Foreground="#CFD8DC" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                                <Border Background="#161B22" CornerRadius="3" Padding="5,2" Margin="0,0,6,0">
                                                    <StackPanel Orientation="Horizontal">
                                                        <TextBlock Text="Volumes: " FontSize="11" Foreground="#607286" />
                                                        <TextBlock Text="{Binding VolumesDisplay}" FontSize="11" Foreground="#CFD8DC" FontWeight="SemiBold" />
                                                    </StackPanel>
                                                </Border>
                                            </WrapPanel>
                                        </StackPanel>

                                        <!-- System Drive Warning Badge -->
                                        <Border Grid.Column="1" 
                                                Background="#26394E" 
                                                BorderBrush="{StaticResource PrimaryAccentBrush}" 
                                                BorderThickness="1" 
                                                CornerRadius="4" 
                                                Padding="10,4" 
                                                VerticalAlignment="Top" 
                                                Visibility="{Binding IsSystemDrive, Converter={StaticResource BoolToVisibilityConverter}}">
                                            <TextBlock Text="🛡 SYSTEM DISK (PROTECTED)" 
                                                       FontWeight="Bold" 
                                                       FontSize="11" 
                                                       Foreground="{StaticResource PrimaryAccentBrush}" />
                                        </Border>
                                    </Grid>

                                    <!-- Divider -->
                                    <Rectangle Grid.Row="1" Height="1" Fill="#283444" Margin="0,10,0,12" />

                                    <!-- Health Information Tiles (4 Responsive Balanced Columns) -->
                                    <Grid Grid.Row="2">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Tile 1: Health Status & % -->
                                        <Border Grid.Column="0" Background="#161C24" BorderBrush="#263342" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="0,0,5,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="HEALTH STATUS" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                                <StackPanel Orientation="Horizontal" Margin="0,4,0,0" VerticalAlignment="Center">
                                                    <Border Background="{Binding HealthStatus, Converter={StaticResource HealthStatusToBackgroundBrushConverter}}" 
                                                            BorderBrush="{Binding HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}" 
                                                            BorderThickness="1" 
                                                            CornerRadius="3" 
                                                            Padding="6,2" 
                                                            Margin="0,0,6,0">
                                                        <TextBlock Text="{Binding HealthStatusText}" 
                                                                   FontWeight="Bold" 
                                                                   FontSize="12" 
                                                                   Foreground="{Binding HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}" />
                                                    </Border>
                                                    <TextBlock Text="{Binding HealthScoreDisplay}" 
                                                               FontWeight="Bold" 
                                                               FontSize="18" 
                                                               Foreground="{Binding HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}" 
                                                               VerticalAlignment="Center" />
                                                </StackPanel>
                                                <TextBlock Text="SSD Endurance Life" FontSize="10" Foreground="#5A6D82" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tile 2: Temperature -->
                                        <Border Grid.Column="1" Background="#161C24" BorderBrush="#263342" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="5,0,5,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="TEMPERATURE" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding TemperatureDisplay}" 
                                                           FontWeight="Bold" 
                                                           FontSize="18" 
                                                           Foreground="{StaticResource LightTextBrush}" 
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="Thermal Sensor" FontSize="10" Foreground="#5A6D82" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tile 3: Power On Hours -->
                                        <Border Grid.Column="2" Background="#161C24" BorderBrush="#263342" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="5,0,5,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="POWER ON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding PowerOnHoursDisplay}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="16" 
                                                           Foreground="{StaticResource LightTextBrush}" 
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding PowerCycles, StringFormat='Cycles: {0:N0}'}" FontSize="10" Foreground="#5A6D82" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>

                                        <!-- Tile 4: Total Writes -->
                                        <Border Grid.Column="3" Background="#161C24" BorderBrush="#263342" BorderThickness="1" CornerRadius="4" Padding="12,8" Margin="5,0,0,0">
                                            <StackPanel Orientation="Vertical">
                                                <TextBlock Text="TOTAL WRITES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                                <TextBlock Text="{Binding TotalHostWrites}" 
                                                           FontWeight="SemiBold" 
                                                           FontSize="16" 
                                                           Foreground="{StaticResource LightTextBrush}" 
                                                           Margin="0,4,0,0" />
                                                <TextBlock Text="{Binding TotalHostReads, StringFormat='Reads: {0}'}" FontSize="10" Foreground="#5A6D82" Margin="0,3,0,0" />
                                            </StackPanel>
                                        </Border>
                                    </Grid>

                                    <!-- Notice when SMART is not exposed by USB enclosure -->
                                    <Border Grid.Row="3" 
                                            Background="#241E15" 
                                            BorderBrush="#5E4B20" 
                                            BorderThickness="1" 
                                            CornerRadius="4" 
                                            Padding="10,6" 
                                            Margin="0,10,0,0"
                                            Visibility="{Binding HasSmartData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                                        <StackPanel Orientation="Horizontal">
                                            <TextBlock Text="ℹ " Foreground="{StaticResource WarningBrush}" FontWeight="Bold" FontSize="13" />
                                            <TextBlock Text="{Binding SmartUnavailableReason}" 
                                                       Foreground="#FFE082" 
                                                       FontSize="11" 
                                                       VerticalAlignment="Center" />
                                        </StackPanel>
                                    </Border>

                                    <!-- Bottom Row: Detailed Diagnostics Link & Configurable FORMAT Actions -->
                                    <Grid Grid.Row="4" Margin="0,14,0,0">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                        </Grid.ColumnDefinitions>

                                        <!-- Detailed SMART Link -->
                                        <Button Grid.Column="0" 
                                                Content="Inspect Detailed SMART / NVMe Telemetry →" 
                                                Command="{Binding DataContext.OpenHealthDetailsCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                CommandParameter="{Binding}" 
                                                Style="{StaticResource SecondaryButtonStyle}" 
                                                Background="Transparent" 
                                                BorderThickness="0" 
                                                Foreground="{StaticResource PrimaryAccentBrush}" 
                                                HorizontalAlignment="Left" 
                                                FontSize="12" 
                                                Cursor="Hand" />

                                        <!-- Configurable Format Buttons (Driven by Gear Preferences) -->
                                        <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                            <!-- 1. Quick Format (1-Click with instant confirmation) -->
                                            <Button Content="⚡ QUICK FORMAT" 
                                                    Command="{Binding DataContext.RequestQuickFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    IsEnabled="{Binding IsSystemDrive, Converter={StaticResource InverseBoolConverter}}" 
                                                    Visibility="{Binding DataContext.ShowQuickFormatButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource DangerButtonStyle}" 
                                                    Padding="14,8" 
                                                    FontSize="12" 
                                                    FontWeight="Bold" 
                                                    Margin="0,0,8,0" />

                                            <!-- 2. Rufus Advanced Format Page -->
                                            <Button Content="⚙ RUFUS FORMAT" 
                                                    Command="{Binding DataContext.OpenFormatCommand, RelativeSource={RelativeSource AncestorType=UserControl}}" 
                                                    CommandParameter="{Binding}" 
                                                    IsEnabled="{Binding IsSystemDrive, Converter={StaticResource InverseBoolConverter}}" 
                                                    Visibility="{Binding DataContext.ShowRufusFormatButton, RelativeSource={RelativeSource AncestorType=UserControl}, Converter={StaticResource BoolToVisibilityConverter}}"
                                                    Style="{StaticResource SecondaryButtonStyle}" 
                                                    Padding="14,8" 
                                                    FontSize="12" 
                                                    FontWeight="Bold" />
                                        </StackPanel>
                                    </Grid>
                                </Grid>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </Grid>
        </ScrollViewer>

        <!-- Quick Format Confirmation Modal Overlay (1-Click Format Flow) -->
        <Grid Visibility="{Binding IsQuickFormatConfirmationOpen, Converter={StaticResource BoolToVisibilityConverter}}"
              Background="#D9090D12"
              Panel.ZIndex="1000">
            <Border Background="#161E28"
                    BorderBrush="#FF3D00"
                    BorderThickness="2"
                    CornerRadius="8"
                    MaxWidth="540"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Padding="24">
                <StackPanel Orientation="Vertical">
                    <!-- Modal Title -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12" VerticalAlignment="Center">
                        <Border Background="#3B181A" BorderBrush="#FF3D00" BorderThickness="1" CornerRadius="4" Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="⚠" Foreground="#FF3D00" FontSize="18" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="CONFIRM DRIVE QUICK FORMAT" FontWeight="Bold" FontSize="15" Foreground="#FF5C5C" />
                            <TextBlock Text="WARNING: ALL EXISTING PARTITIONS &amp; DATA WILL BE DESTROYED" FontSize="11" Foreground="#90A4AE" Margin="0,2,0,0" />
                        </StackPanel>
                    </StackPanel>

                    <Rectangle Height="1" Fill="#283444" Margin="0,0,0,14" />

                    <!-- Target Drive Summary Box -->
                    <Border Background="#10151C" BorderBrush="#253040" BorderThickness="1" CornerRadius="6" Padding="14,12" Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Target Drive:" FontSize="12" Foreground="#90A4AE" Width="105" />
                                <TextBlock Grid.Column="1" Text="{Binding QuickFormatTargetDrive.Model}" FontWeight="Bold" FontSize="13" Foreground="#FFFFFF" />
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Capacity / Disk:" FontSize="12" Foreground="#90A4AE" Width="105" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding QuickFormatTargetDrive.FormattedCapacity}" FontWeight="Bold" FontSize="12" Foreground="#00A3FF" />
                                    <TextBlock Text="  •  " Foreground="#607286" />
                                    <TextBlock Text="{Binding QuickFormatTargetDrive.DiskNumber, StringFormat='Disk {0}'}" FontSize="12" Foreground="#FFFFFF" />
                                    <TextBlock Text="  •  " Foreground="#607286" />
                                    <TextBlock Text="{Binding QuickFormatTargetDrive.InterfaceDisplay}" FontSize="12" Foreground="#90A4AE" />
                                </StackPanel>
                            </Grid>
                            <Grid Margin="0,6,0,0">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="Auto" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="Parameters:" FontSize="12" Foreground="#90A4AE" Width="105" />
                                <StackPanel Grid.Column="1" Orientation="Horizontal">
                                    <TextBlock Text="{Binding DefaultQuickPartitionScheme}" FontWeight="Bold" FontSize="12" Foreground="#00E676" />
                                    <TextBlock Text="  •  " Foreground="#607286" />
                                    <TextBlock Text="{Binding DefaultQuickFileSystem}" FontWeight="Bold" FontSize="12" Foreground="#00E676" />
                                    <TextBlock Text="  •  Label: " Foreground="#90A4AE" FontSize="12" />
                                    <TextBlock Text="{Binding DefaultQuickVolumeLabel}" FontWeight="Bold" FontSize="12" Foreground="#FFFFFF" />
                                </StackPanel>
                            </Grid>
                        </StackPanel>
                    </Border>

                    <!-- Real-time Progress when formatting -->
                    <StackPanel Visibility="{Binding IsQuickFormatting, Converter={StaticResource BoolToVisibilityConverter}}" Margin="0,0,0,14">
                        <ProgressBar Value="{Binding QuickFormatProgress}" Maximum="100" Height="14" Margin="0,0,0,6" Style="{StaticResource ModernProgressBarStyle}" />
                        <Grid>
                            <TextBlock Text="{Binding QuickFormatStatus}" FontSize="11" Foreground="#00A3FF" FontWeight="SemiBold" />
                            <TextBlock Text="{Binding QuickFormatElapsed, StringFormat='Elapsed: {0}'}" FontSize="11" Foreground="#90A4AE" HorizontalAlignment="Right" />
                        </Grid>
                    </StackPanel>

                    <!-- Buttons: Cancel & One-Click Confirm -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="12" />
                            <ColumnDefinition Width="*" />
                        </Grid.ColumnDefinitions>
                        <Button Grid.Column="0" 
                                Content="CANCEL" 
                                Command="{Binding CancelQuickFormatCommand}" 
                                IsEnabled="{Binding IsQuickFormatting, Converter={StaticResource InverseBoolConverter}}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Height="40" 
                                FontSize="12" 
                                FontWeight="Bold" />
                        <Button Grid.Column="2" 
                                Content="[ OK, FORMAT NOW ]" 
                                Command="{Binding ConfirmQuickFormatCommand}" 
                                IsEnabled="{Binding IsQuickFormatting, Converter={StaticResource InverseBoolConverter}}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Height="40" 
                                FontSize="12" 
                                FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>
