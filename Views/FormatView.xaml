<UserControl x:Class="BBTechSSDTool.Views.FormatView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:BBTechSSDTool.Models"
             xmlns:viewmodels="clr-namespace:BBTechSSDTool.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:FormatViewModel}"
             Background="Transparent">

    <!-- Responsive Centered Container for Rufus-style Format Form -->
    <Grid MaxWidth="860" Margin="16,12" HorizontalAlignment="Center">
        <!-- Main Layout -->
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <!-- Navigation Back Button & Page Header -->
            <Grid Grid.Row="0" Margin="0,0,0,12">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <Button Content="← BACK TO DASHBOARD" 
                        Command="{Binding BackCommand}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="12,5" 
                        FontSize="11" />

                <StackPanel Grid.Column="1" HorizontalAlignment="Right" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="RUFUS-COMPATIBLE STORAGE ENGINE" 
                               FontSize="11" 
                               FontWeight="Bold" 
                               Foreground="{StaticResource MutedTextBrush}" />
                </StackPanel>
            </Grid>

            <!-- Formatting Form Content (Rufus Layout) -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <StackPanel Orientation="Vertical" MaxWidth="820" HorizontalAlignment="Center">

                    <!-- Target Drive Identification Card (Rufus Device Header) -->
                    <Border Background="{StaticResource SurfaceBackgroundBrush}" 
                            BorderBrush="{StaticResource PrimaryAccentBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="14,12" 
                            Margin="0,0,0,14">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="Auto" />
                            </Grid.ColumnDefinitions>

                            <StackPanel Orientation="Vertical">
                                <TextBlock Text="TARGET DEVICE" 
                                           FontWeight="Bold" 
                                           FontSize="10" 
                                           Foreground="{StaticResource PrimaryAccentBrush}" />
                                <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="0,2,0,0">
                                    <TextBlock Text="{Binding Drive.Model}" 
                                               FontWeight="Bold" 
                                               FontSize="16" 
                                               Foreground="{StaticResource LightTextBrush}" />
                                    <TextBlock Text="  " />
                                    <TextBlock Text="{Binding Drive.FormattedCapacity}" 
                                               FontWeight="Bold" 
                                               FontSize="16" 
                                               Foreground="{StaticResource SuccessBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                    <TextBlock Text="{Binding Drive.DiskNumber, StringFormat='Disk {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="#CBD5E1" />
                                    <TextBlock Text="  •  " Foreground="#4A5568" />
                                    <TextBlock Text="{Binding Drive.InterfaceDisplay}" FontSize="12" Foreground="#94A3B8" />
                                    <TextBlock Text="  •  Serial: " FontSize="12" Foreground="#64748B" Margin="6,0,0,0" />
                                    <TextBlock Text="{Binding Drive.SerialNumber}" FontSize="12" FontWeight="SemiBold" Foreground="#CBD5E1" />
                                </StackPanel>
                            </StackPanel>

                            <Border Grid.Column="1" 
                                    Background="#142838" 
                                    BorderBrush="{StaticResource PrimaryAccentBrush}" 
                                    BorderThickness="1" 
                                    CornerRadius="4" 
                                    Padding="10,6" 
                                    VerticalAlignment="Center">
                                <TextBlock Text="READY TO PREPARE" 
                                           FontWeight="Bold" 
                                           FontSize="11" 
                                           Foreground="{StaticResource PrimaryAccentBrush}" />
                            </Border>
                        </Grid>
                    </Border>

                    <!-- Drive Properties (Rufus Group 1) -->
                    <Border Background="{StaticResource CardBackgroundBrush}" 
                            BorderBrush="{StaticResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="16,14" 
                            Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="DRIVE PROPERTIES" 
                                       FontWeight="Bold" 
                                       FontSize="11" 
                                       Foreground="{StaticResource MutedTextBrush}" 
                                       Margin="0,0,0,12" />

                            <!-- Boot Selection & ISO Picker -->
                            <Grid Margin="0,0,0,10">
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto" />
                                    <RowDefinition Height="Auto" />
                                </Grid.RowDefinitions>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Row="0" Grid.Column="0" Margin="0,0,10,0">
                                    <TextBlock Text="Boot selection" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding BootSelections}" 
                                              SelectedItem="{Binding SelectedBootSelection}" 
                                              DisplayMemberPath="Display" 
                                              Background="#1E252F" 
                                              Foreground="{StaticResource LightTextBrush}" 
                                              Padding="8,5" 
                                              BorderBrush="{StaticResource CardBorderBrush}" />
                                </StackPanel>

                                <Button Grid.Row="0" Grid.Column="1" 
                                        Content="SELECT..." 
                                        Command="{Binding SelectIsoCommand}" 
                                        Visibility="{Binding IsIsoSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                                        Style="{StaticResource PrimaryButtonStyle}" 
                                        Padding="14,6" 
                                        VerticalAlignment="Bottom" 
                                        Height="32" 
                                        FontSize="11" />

                                <!-- Selected ISO Details Banner -->
                                <Border Grid.Row="1" Grid.ColumnSpan="2" 
                                        Background="#141E28" 
                                        BorderBrush="{StaticResource PrimaryAccentBrush}" 
                                        BorderThickness="1" 
                                        CornerRadius="4" 
                                        Padding="8,6" 
                                        Margin="0,8,0,0" 
                                        Visibility="{Binding IsIsoSelectionVisible, Converter={StaticResource BoolToVisibilityConverter}}">
                                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                                        <TextBlock Text="💿 " FontSize="12" />
                                        <TextBlock Text="{Binding IsoDisplayName}" FontSize="12" FontWeight="SemiBold" Foreground="{StaticResource PrimaryAccentBrush}" />
                                    </StackPanel>
                                </Border>
                            </Grid>

                            <!-- Image Option (When ISO is loaded) -->
                            <StackPanel Margin="0,0,0,10" Visibility="{Binding HasIsoSelected, Converter={StaticResource BoolToVisibilityConverter}}">
                                <TextBlock Text="Image option" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" Margin="0,0,0,4" />
                                <ComboBox ItemsSource="{Binding ImageOptions}" 
                                          SelectedItem="{Binding SelectedImageOption}" 
                                          DisplayMemberPath="Display" 
                                          Background="#1E252F" 
                                          Foreground="{StaticResource LightTextBrush}" 
                                          Padding="8,5" 
                                          BorderBrush="{StaticResource CardBorderBrush}" />
                            </StackPanel>

                            <!-- Partition Scheme & Target System -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="Partition scheme" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding PartitionSchemes}" 
                                              SelectedItem="{Binding SelectedPartitionSchemeOption}" 
                                              DisplayMemberPath="Display" 
                                              Background="#1E252F" 
                                              Foreground="{StaticResource LightTextBrush}" 
                                              Padding="8,5" 
                                              BorderBrush="{StaticResource CardBorderBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Target system" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding TargetSystems}" 
                                              SelectedItem="{Binding SelectedTargetSystemOption}" 
                                              DisplayMemberPath="Display" 
                                              Background="#1E252F" 
                                              Foreground="{StaticResource LightTextBrush}" 
                                              Padding="8,5" 
                                              BorderBrush="{StaticResource CardBorderBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Advanced Drive Properties Toggle -->
                            <CheckBox IsChecked="{Binding ShowAdvancedProperties}" Margin="0,4,0,0" Foreground="{StaticResource MutedTextBrush}">
                                <TextBlock Text="Show advanced drive properties (Old BIOS fixes, Rufus MBR)" FontSize="11" />
                            </CheckBox>

                            <StackPanel Orientation="Vertical" Margin="20,8,0,0" Visibility="{Binding ShowAdvancedProperties, Converter={StaticResource BoolToVisibilityConverter}}">
                                <CheckBox IsChecked="{Binding ListUsbHardDrives}" Margin="0,0,0,6" Foreground="{StaticResource LightTextBrush}">
                                    <TextBlock Text="List USB Hard Drives" FontSize="12" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding AddOldBiosFixes}" Margin="0,0,0,6" Foreground="{StaticResource LightTextBrush}">
                                    <TextBlock Text="Add fixes for old BIOSes (extra partition alignment)" FontSize="12" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding UseRufusMbr}" Foreground="{StaticResource LightTextBrush}">
                                    <TextBlock Text="Use Rufus MBR with BIOS ID" FontSize="12" />
                                </CheckBox>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Format Options (Rufus Group 2) -->
                    <Border Background="{StaticResource CardBackgroundBrush}" 
                            BorderBrush="{StaticResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="16,14" 
                            Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="FORMAT OPTIONS" 
                                       FontWeight="Bold" 
                                       FontSize="11" 
                                       Foreground="{StaticResource MutedTextBrush}" 
                                       Margin="0,0,0,12" />

                            <!-- Volume Label -->
                            <StackPanel Margin="0,0,0,10">
                                <TextBlock Text="Volume label" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" Margin="0,0,0,4" />
                                <TextBox Text="{Binding VolumeLabel, UpdateSourceTrigger=PropertyChanged}" 
                                         Background="#1E252F" 
                                         Foreground="{StaticResource LightTextBrush}" 
                                         Padding="8,6" 
                                         BorderBrush="{StaticResource CardBorderBrush}" 
                                         FontSize="12" />
                            </StackPanel>

                            <!-- File System & Cluster Size -->
                            <Grid Margin="0,0,0,10">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="14" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>

                                <StackPanel Grid.Column="0">
                                    <TextBlock Text="File system" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding FileSystems}" 
                                              SelectedItem="{Binding SelectedFileSystemOption}" 
                                              DisplayMemberPath="Display" 
                                              Background="#1E252F" 
                                              Foreground="{StaticResource LightTextBrush}" 
                                              Padding="8,5" 
                                              BorderBrush="{StaticResource CardBorderBrush}" />
                                </StackPanel>

                                <StackPanel Grid.Column="2">
                                    <TextBlock Text="Cluster size" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" Margin="0,0,0,4" />
                                    <ComboBox ItemsSource="{Binding ClusterSizes}" 
                                              SelectedItem="{Binding SelectedClusterSizeOption}" 
                                              DisplayMemberPath="Display" 
                                              Background="#1E252F" 
                                              Foreground="{StaticResource LightTextBrush}" 
                                              Padding="8,5" 
                                              BorderBrush="{StaticResource CardBorderBrush}" />
                                </StackPanel>
                            </Grid>

                            <!-- Checkboxes -->
                            <StackPanel Orientation="Vertical">
                                <CheckBox IsChecked="{Binding IsQuickFormat}" Margin="0,0,0,6" Foreground="{StaticResource LightTextBrush}">
                                    <TextBlock Text="Quick format" FontSize="12" />
                                </CheckBox>
                                <CheckBox IsChecked="{Binding CreateExtendedLabelAndIcon}" Margin="0,0,0,6" Foreground="{StaticResource LightTextBrush}">
                                    <TextBlock Text="Create extended label and icon files" FontSize="12" />
                                </CheckBox>
                                
                                <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                                    <CheckBox IsChecked="{Binding IsBadBlockCheck}" Foreground="{StaticResource LightTextBrush}" VerticalAlignment="Center">
                                        <TextBlock Text="Check device for bad blocks" FontSize="12" />
                                    </CheckBox>
                                    <ComboBox ItemsSource="{Binding BadBlockPassOptions}" 
                                              SelectedItem="{Binding SelectedBadBlockPass}" 
                                              Visibility="{Binding IsBadBlockPassVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                                              Background="#1E252F" 
                                              Foreground="{StaticResource LightTextBrush}" 
                                              Margin="10,0,0,0" 
                                              Padding="6,2" 
                                              Height="24" 
                                              FontSize="11" />
                                    <TextBlock Text="pass(es)" 
                                               Visibility="{Binding IsBadBlockPassVisible, Converter={StaticResource BoolToVisibilityConverter}}" 
                                               Foreground="#94A3B8" 
                                               FontSize="11" 
                                               VerticalAlignment="Center" 
                                               Margin="4,0,0,0" />
                                </StackPanel>
                            </StackPanel>
                        </StackPanel>
                    </Border>

                    <!-- Real-time Progress & Activity Log (Rufus Status Console) -->
                    <Border Background="#161B22" 
                            BorderBrush="{StaticResource CardBorderBrush}" 
                            BorderThickness="1" 
                            CornerRadius="6" 
                            Padding="14,10" 
                            Margin="0,0,0,14">
                        <StackPanel Orientation="Vertical">
                            <Grid Margin="0,0,0,6">
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="STATUS: " FontSize="11" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                                    <TextBlock Text="{Binding StatusMessage}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource LightTextBrush}" />
                                </StackPanel>
                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                    <TextBlock Text="{Binding ElapsedTimeDisplay}" FontSize="11" Foreground="#94A3B8" Margin="0,0,12,0" />
                                    <TextBlock Text="{Binding ProgressPercentage, StringFormat='{}{0}%'}" FontWeight="Bold" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </StackPanel>
                            </Grid>

                            <ProgressBar Value="{Binding ProgressPercentage}" 
                                         Height="8" 
                                         Background="#252D37" 
                                         Foreground="{StaticResource PrimaryAccentBrush}" 
                                         BorderThickness="0" 
                                         Margin="0,0,0,8" />

                            <Grid>
                                <Button Command="{Binding ToggleLogCommand}" 
                                        Style="{StaticResource SecondaryButtonStyle}" 
                                        Background="Transparent" 
                                        BorderThickness="0" 
                                        HorizontalAlignment="Left" 
                                        Padding="0" 
                                        FontSize="11">
                                    <TextBlock Text="📄 Toggle Disk Activity Log" Foreground="{StaticResource PrimaryAccentBrush}" />
                                </Button>
                            </Grid>

                            <TextBox Text="{Binding ActivityLog}" 
                                     Visibility="{Binding ShowLogWindow, Converter={StaticResource BoolToVisibilityConverter}}" 
                                     IsReadOnly="True" 
                                     Background="#0E1217" 
                                     Foreground="#94A3B8" 
                                     BorderThickness="0" 
                                     FontFamily="Consolas" 
                                     FontSize="11" 
                                     Height="90" 
                                     Margin="0,8,0,0" 
                                     VerticalScrollBarVisibility="Auto" />
                        </StackPanel>
                    </Border>
                </StackPanel>
            </ScrollViewer>

            <!-- Bottom Actions Bar (Rufus Action Bar) -->
            <Grid Grid.Row="2" Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>

                <Button Grid.Column="0" 
                        Content="CANCEL / ABORT" 
                        Command="{Binding AbortFormatCommand}" 
                        Visibility="{Binding IsFormatting, Converter={StaticResource BoolToVisibilityConverter}}" 
                        Style="{StaticResource SecondaryButtonStyle}" 
                        Padding="16,8" 
                        FontSize="12" />

                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="[ CLOSE ]" 
                            Command="{Binding BackCommand}" 
                            Visibility="{Binding IsFormatting, Converter={StaticResource InverseBoolToVisibilityConverter}}" 
                            Style="{StaticResource SecondaryButtonStyle}" 
                            Padding="16,8" 
                            FontSize="12" 
                            Margin="0,0,10,0" />

                    <!-- Primary START Button (One-Click Confirmation) -->
                    <Button Content="[ START ]" 
                            Command="{Binding RequestFormatCommand}" 
                            Visibility="{Binding IsFormatting, Converter={StaticResource InverseBoolToVisibilityConverter}}" 
                            Style="{StaticResource DangerButtonStyle}" 
                            MinWidth="160" 
                            Height="38" 
                            FontSize="13" 
                            FontWeight="Bold" />
                </StackPanel>
            </Grid>
        </Grid>

        <!-- SAFETY CONFIRMATION MODAL OVERLAY (ONE-CLICK FORMAT CONFIRMATION) -->
        <Grid Background="#D00A0D11" 
              Visibility="{Binding IsConfirmationDialogOpen, Converter={StaticResource BoolToVisibilityConverter}}">
            <Border Background="#1C212A" 
                    BorderBrush="{StaticResource DangerBrush}" 
                    BorderThickness="2" 
                    CornerRadius="8" 
                    Width="480" 
                    VerticalAlignment="Center" 
                    HorizontalAlignment="Center" 
                    Padding="22">
                <StackPanel Orientation="Vertical">
                    <!-- Warning Header -->
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <TextBlock Text="⚠️ " FontSize="22" Foreground="{StaticResource DangerBrush}" VerticalAlignment="Center" />
                        <TextBlock Text="WARNING: ALL DATA WILL BE DESTROYED" 
                                   FontWeight="Bold" 
                                   FontSize="15" 
                                   Foreground="{StaticResource DangerBrush}" 
                                   VerticalAlignment="Center" />
                    </StackPanel>

                    <!-- Drive Identity Confirmation -->
                    <TextBlock Text="All data on the following physical device will be permanently erased:" FontSize="12" Foreground="{StaticResource LightTextBrush}" />

                    <Border Background="#14181F" BorderBrush="#353F4D" BorderThickness="1" CornerRadius="4" Padding="12" Margin="0,10,0,12">
                        <StackPanel Orientation="Vertical">
                            <TextBlock Text="{Binding Drive.Model}" FontWeight="Bold" FontSize="15" Foreground="{StaticResource LightTextBrush}" />
                            <StackPanel Orientation="Horizontal" Margin="0,3,0,0">
                                <TextBlock Text="{Binding Drive.FormattedCapacity, StringFormat='Capacity: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" />
                                <TextBlock Text="  •  " Foreground="#4A5568" />
                                <TextBlock Text="{Binding Drive.DiskNumber, StringFormat='Disk {0}'}" FontSize="12" Foreground="#CBD5E1" />
                            </StackPanel>
                            <TextBlock Text="{Binding Drive.SerialNumber, StringFormat='Serial: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                        </StackPanel>
                    </Border>

                    <TextBlock Text="To continue with this operation, click FORMAT NOW. To quit, click CANCEL." 
                               FontSize="12" 
                               Foreground="#B0BEC5" 
                               Margin="0,0,0,18" />

                    <!-- One-Click Confirmation Buttons -->
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>

                        <Button Content="CANCEL" 
                                Command="{Binding CancelConfirmationCommand}" 
                                Style="{StaticResource SecondaryButtonStyle}" 
                                Padding="16,8" 
                                FontSize="12" />

                        <!-- ONE CLICK FORMAT ACTION -->
                        <Button Grid.Column="1" 
                                Content="[ OK, FORMAT NOW ]" 
                                Command="{Binding ConfirmFormatCommand}" 
                                Style="{StaticResource DangerButtonStyle}" 
                                Padding="20,8" 
                                FontSize="13" 
                                FontWeight="Bold" />
                    </Grid>
                </StackPanel>
            </Border>
        </Grid>
    </Grid>
</UserControl>