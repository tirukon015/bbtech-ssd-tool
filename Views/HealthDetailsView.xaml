<UserControl x:Class="BBTechSSDTool.Views.HealthDetailsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:models="clr-namespace:BBTechSSDTool.Models"
             xmlns:viewmodels="clr-namespace:BBTechSSDTool.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance Type=viewmodels:HealthDetailsViewModel}"
             Background="Transparent">

    <!-- Responsive Centered Container for Health Diagnostics -->
    <Grid MaxWidth="880" Margin="16,12" HorizontalAlignment="Center">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <!-- Header Bar -->
        <Grid Grid.Row="0" Margin="0,0,0,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>

            <Button Content="← BACK TO DASHBOARD" 
                    Command="{Binding BackCommand}" 
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Padding="12,6" 
                    FontSize="12" />

            <StackPanel Grid.Column="1" HorizontalAlignment="Center" Orientation="Horizontal">
                <TextBlock Text="DETAILED HEALTH &amp; SMART / NVME DIAGNOSTICS" 
                           FontSize="12" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource MutedTextBrush}" 
                           VerticalAlignment="Center" 
                            />
            </StackPanel>

            <Button Grid.Column="2" 
                    Content="📄 EXPORT REPORT" 
                    Command="{Binding ExportReportCommand}" 
                    Style="{StaticResource SecondaryButtonStyle}" 
                    Padding="12,6" 
                    FontSize="12" />
        </Grid>

        <!-- Drive Summary Strip -->
        <Border Grid.Row="1" 
                Background="{StaticResource CardBackgroundBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="16" 
                Margin="0,0,0,16">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="2*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>

                <StackPanel Grid.Column="0">
                    <TextBlock Text="{Binding Drive.Model}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource LightTextBrush}" />
                    <TextBlock Text="{Binding Drive.FormattedCapacity, StringFormat='Capacity: {0}'}" FontWeight="SemiBold" FontSize="12" Foreground="{StaticResource PrimaryAccentBrush}" Margin="0,2,0,0" />
                    <TextBlock Text="{Binding Drive.SerialNumber, StringFormat='S/N: {0}'}" FontSize="11" Foreground="#94A3B8" Margin="0,2,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="1">
                    <TextBlock Text="HEALTH" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Drive.HealthStatusText}" FontWeight="Bold" FontSize="16" Foreground="{Binding Drive.HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}" Margin="0,4,0,0" />
                    <TextBlock Text="{Binding Drive.HealthScoreDisplay}" FontWeight="Bold" FontSize="13" Foreground="{Binding Drive.HealthStatus, Converter={StaticResource HealthStatusToBrushConverter}}" />
                </StackPanel>

                <StackPanel Grid.Column="2">
                    <TextBlock Text="TEMP" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Drive.TemperatureDisplay}" FontWeight="Bold" FontSize="16" Foreground="{StaticResource LightTextBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="3">
                    <TextBlock Text="POWER-ON" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Drive.PowerOnHoursDisplay}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource LightTextBrush}" Margin="0,4,0,0" />
                </StackPanel>

                <StackPanel Grid.Column="4">
                    <TextBlock Text="TOTAL WRITES" FontSize="10" FontWeight="Bold" Foreground="{StaticResource MutedTextBrush}" />
                    <TextBlock Text="{Binding Drive.TotalHostWrites}" FontWeight="SemiBold" FontSize="14" Foreground="{StaticResource LightTextBrush}" Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>

        <!-- Detailed Attributes DataGrid -->
        <Border Grid.Row="2" 
                Background="{StaticResource SurfaceBackgroundBrush}" 
                BorderBrush="{StaticResource CardBorderBrush}" 
                BorderThickness="1" 
                CornerRadius="6" 
                Padding="16">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="*" />
                </Grid.RowDefinitions>

                <TextBlock Grid.Row="0" 
                           Text="HARDWARE SMART / NVMe ATTRIBUTE TABLE" 
                           FontSize="11" 
                           FontWeight="Bold" 
                           Foreground="{StaticResource MutedTextBrush}" 
                            
                           Margin="0,0,0,10" />

                <!-- When SMART data is available -->
                <DataGrid Grid.Row="1" 
                          ItemsSource="{Binding Drive.SmartAttributes}" 
                          AutoGenerateColumns="False" 
                          IsReadOnly="True" 
                          Background="Transparent" 
                          RowBackground="#181D24" 
                          AlternatingRowBackground="#1D232C" 
                          Foreground="{StaticResource LightTextBrush}" 
                          BorderThickness="0" 
                          GridLinesVisibility="Horizontal" 
                          HorizontalGridLinesBrush="#28323E" 
                          HeadersVisibility="Column" 
                          CanUserAddRows="False" 
                          CanUserDeleteRows="False" 
                          CanUserResizeRows="False" 
                          SelectionMode="Single"
                          Visibility="{Binding Drive.HasSmartData, Converter={StaticResource BoolToVisibilityConverter}}">
                    <DataGrid.ColumnHeaderStyle>
                        <Style TargetType="DataGridColumnHeader">
                            <Setter Property="Background" Value="#14181F" />
                            <Setter Property="Foreground" Value="{StaticResource MutedTextBrush}" />
                            <Setter Property="FontWeight" Value="Bold" />
                            <Setter Property="FontSize" Value="11" />
                            <Setter Property="Padding" Value="10,6" />
                            <Setter Property="BorderThickness" Value="0,0,0,1" />
                            <Setter Property="BorderBrush" Value="#2E3846" />
                        </Style>
                    </DataGrid.ColumnHeaderStyle>
                    <DataGrid.RowStyle>
                        <Style TargetType="DataGridRow">
                            <Setter Property="FontSize" Value="12" />
                            <Setter Property="Padding" Value="6" />
                        </Style>
                    </DataGrid.RowStyle>
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="ID" Binding="{Binding Id, StringFormat='0x{0:X2}'}" Width="60" />
                        <DataGridTextColumn Header="Attribute Name" Binding="{Binding Name}" Width="280" />
                        <DataGridTextColumn Header="Current" Binding="{Binding Current}" Width="80" />
                        <DataGridTextColumn Header="Worst" Binding="{Binding Worst}" Width="80" />
                        <DataGridTextColumn Header="Raw Value" Binding="{Binding RawDisplay}" Width="160" />
                        <DataGridTextColumn Header="Status" Binding="{Binding Status}" Width="100" />
                    </DataGrid.Columns>
                </DataGrid>

                <!-- When SMART data is unavailable from enclosure -->
                <StackPanel Grid.Row="1" 
                            VerticalAlignment="Center" 
                            HorizontalAlignment="Center" 
                            Visibility="{Binding Drive.HasSmartData, Converter={StaticResource InverseBoolToVisibilityConverter}}">
                    <TextBlock Text="SMART / NVMe Telemetry Unavailable" 
                               FontWeight="Bold" 
                               FontSize="16" 
                               Foreground="{StaticResource WarningBrush}" 
                               HorizontalAlignment="Center" />
                    <TextBlock Text="{Binding Drive.SmartUnavailableReason}" 
                               FontSize="13" 
                               Foreground="#B0BEC5" 
                               HorizontalAlignment="Center" 
                               Margin="0,8,0,0" />
                    <TextBlock Text="The USB enclosure bridge controller does not route direct ATA or NVMe passthrough commands to the host." 
                               FontSize="12" 
                               Foreground="#64748B" 
                               HorizontalAlignment="Center" 
                               Margin="0,4,0,0" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</UserControl>
